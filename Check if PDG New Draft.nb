          RowBox[{"VertexCount", "[", 
           RowBox[{"GraphsGivenEdgeCount", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ECount", " ", "=", " ", 
          RowBox[{"EdgeCount", "[", 
           RowBox[{"GraphsGivenEdgeCount", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"W", " ", "=", " ", 
          RowBox[{"ReduceWeightSets", "[", 
           RowBox[{
            RowBox[{"WeightSets", "[", 
             RowBox[{"VCount", " ", ",", "ECount"}], "]"}], ",", "VCount"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"PDGs", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"SetSharedVariable", "[", "PDGs", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{"PerfectDistanceQ", ",", "W"}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"ParallelDo", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"PDGQ", " ", "=", 
             RowBox[{"Catch", "[", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"WL", " ", "=", " ", 
                  RowBox[{"Permutations", "[", "Wi", "]"}]}], ";", 
                 RowBox[{"ResWi", " ", "=", 
                  RowBox[{"Catch", "[", 
                   RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"PerfectDistanceQ", "[", 
                    RowBox[{"G", ",", "w"}], "]"}], ",", 
                    RowBox[{"Throw", "[", "True", "]"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"w", ",", "WL"}], "}"}]}], "]"}], "]"}]}], ";", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"ResWi", "===", "True"}], ",", 
                   RowBox[{"Throw", "[", "ResWi", "]"}]}], "]"}], ";"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Wi", ",", "W"}], "}"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
