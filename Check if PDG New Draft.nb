 RowBox[{
  RowBox[{
   RowBox[{"TotalTime", " ", "=", " ", 
    RowBox[{
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "GraphList", "]"}], "!=", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphsGivenEdgeCount", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"GatherBy", "[", 
            RowBox[{"GraphList", ",", "EdgeCount"}], "]"}], "]"}]}], ";", 
