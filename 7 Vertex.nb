Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Helper", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PerfectDistanceQ", "[", 
      RowBox[{"G_", ",", "w_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "@*", "Flatten", "@*", "Round"}], "@", 
       RowBox[{"GraphDistanceMatrix", "[", 
        RowBox[{"Graph", "[", 
         RowBox[{"G", ",", 
          RowBox[{"EdgeWeight", "->", "w"}]}], "]"}], "]"}]}], " ", "==", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WeightSets", "[", 
      RowBox[{"Vn_", ",", "En_"}], "]"}], ":=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Binomial", "[", 
           RowBox[{"Vn", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"{", "En", "}"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&&", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"#", ",", "2"}], "]"}]}], "&"}]}], "]"}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReduceWeightSets", "[", 
     RowBox[{"W_", ",", "Vn_"}], "]"}], ":=", 
    RowBox[{"Pick", "[", 
     RowBox[{"W", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Total", "/@", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Length", "[", 
               RowBox[{"W", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ")"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"Vn", ",", "2"}], "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "W", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReduceWeightSetsDiam", "[", 
     RowBox[{"W_", ",", "G_"}], "]"}], ":=", 
    RowBox[{"Pick", "[", 
     RowBox[{"W", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Total", "/@", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"GraphDiameter", "[", "G", "]"}]}], "]"}]}], ")"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "W", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalWeightings", "[", "G_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"EdgeCount", "[", "G", "]"}], "!"}], 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}], "-", 
         "2"}], ",", 
        RowBox[{
         RowBox[{"EdgeCount", "[", "G", "]"}], "-", "2"}]}], "]"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StatusGraph", "[", 
      RowBox[{"GraphList_", ",", "NPDG_", ",", "MPDG_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"G", ",", "NPDGC", ",", "MPDGC"}], "}"}], ",", 
       RowBox[{
        RowBox[{"G", " ", "=", 
         RowBox[{
          RowBox[{"ResourceFunction", "[", "\"\<HasseDiagram\>\"", "]"}], "[", 
          RowBox[{"IsomorphicSubgraphQ", ",", 
           RowBox[{"CanonicalGraph", "/@", "GraphList"}]}], "]"}]}], ";", 
        RowBox[{"NPDGC", "=", 
         RowBox[{"CanonicalGraph", "/@", "NPDG"}]}], ";", 
        RowBox[{"MPDGC", "=", 
         RowBox[{"CanonicalGraph", "/@", "MPDG"}]}], ";", " ", 
        RowBox[{"HighlightGraph", "[", 
         RowBox[{"G", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"NPDGC", ",", "Red"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"VertexOutComponent", "[", 
               RowBox[{"G", ",", "MPDGC"}], "]"}], ",", "Green"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"MPDGC", ",", "Blue"}], "]"}]}], "}"}], ",", 
          RowBox[{"GraphLayout", "->", "\"\<LayeredDigraphEmbedding\>\""}], 
          ",", 
          RowBox[{"VertexLabels", "->", 
           RowBox[{"MapIndexed", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "->", 
               RowBox[{"Placed", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"VertexList", "[", "G", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "}"}], ",", 
                 RowBox[{"{", "Tooltip", "}"}]}], "]"}]}], "&"}], ",", 
             RowBox[{"VertexList", "[", "G", "]"}]}], "]"}]}], ",", 
          RowBox[{"EdgeStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Thin", ",", "Gray"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
