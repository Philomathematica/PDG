Cell[BoxData[{
 RowBox[{
  RowBox[{"PerfectDistanceQ", "[", "G_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Round", "[", 
      RowBox[{"GraphDistanceMatrix", "[", "G", "]"}], "]"}], "]"}], "]"}], 
   " ", "==", " ", 
   RowBox[{"Range", "[", 
