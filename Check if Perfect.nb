Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"allEdges", "[", "n_", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"UndirectedEdge", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allConnected", "[", "n_", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", "#", ",", 
          RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}], "&"}], ",", 
       RowBox[{"Subsets", "[", 
        RowBox[{"allEdges", "[", "n", "]"}], "]"}]}], "]"}], ",", 
     "ConnectedGraphQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allConnectedUpToIso", "[", "n_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{"allConnected", "[", "n", "]"}], ",", "IsomorphicGraphQ"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vertex5", "=", 
   RowBox[{"allConnectedUpToIso", "[", "5", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"vertex6", "=", 
     RowBox[{"allConnectedUpToIso", "[", "6", "]"}]}], ";"}], 
   "*)"}]}]}], "Input",
