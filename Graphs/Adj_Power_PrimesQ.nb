Cell[BoxData[{
 RowBox[{
  RowBox[{"PrimePiProx", "[", "num_", "]"}], ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"num", "<", "2"}], ",", "0", ",", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"LogIntegral", "[", "num", "]"}], "-", 
      RowBox[{"LogIntegral", "[", "2", "]"}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CountPrimes", "[", 
   RowBox[{"A_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "P", ",", "max", ",", " ", "min", ",", "SampleCount", ",", " ", 
      "PrimeCount", ",", " ", "ProbOfPrime", ",", "Prob"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"P", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixPower", "[", 
         RowBox[{"A", ",", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", "d"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"P", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
            "Statistics`Library`UpperTriangularMatrixToVector", "[", "#", 
             "]"}], ",", 
            RowBox[{"Normal", "[", 
             RowBox[{"Diagonal", "[", "#", "]"}], "]"}]}], "]"}], ",", "0"}], 
         "]"}], "&"}], "/@", "P"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"max", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], "+", "1"}], "&"}], "/@", "P"}]}], 
     " ", ";", "\[IndentingNewLine]", 
     RowBox[{"min", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", "#", "]"}], "&"}], "/@", "P"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrimeCount", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Select", "[", 
          RowBox[{"#", ",", "PrimeQ"}], "]"}], "]"}], "&"}], "/@", "P"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"SampleCount", " ", "=", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"P", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"ProbOfPrime", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"PrimePiProx", "/@", 
             RowBox[{"(", "max", ")"}]}], " ", "-", " ", 
            RowBox[{"PrimePiProx", "/@", 
             RowBox[{"(", 
              RowBox[{"min", "-", "1"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"max", "-", "min", "+", " ", "1"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Prob", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"PDF", "[", 
           RowBox[{
            RowBox[{"BinomialDistribution", "[", 
             RowBox[{"SampleCount", ",", 
              RowBox[{"ProbOfPrime", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"PrimeCount", "[", 
             RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "P", "]"}], "]"}]}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"max", "-", "min"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
