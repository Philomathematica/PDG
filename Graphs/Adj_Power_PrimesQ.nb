  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AList", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"AdjacencyMatrix", "[", "#", "]"}], "&"}], "/@", "Graphs"}]}], 
