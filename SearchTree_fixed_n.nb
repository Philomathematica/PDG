 RowBox[{
  RowBox[{
   RowBox[{"FastChildren", "[", 
    RowBox[{"G_", ",", "n_", ",", "PDGs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vertexCount", ",", "edgeCount", ",", "vertexList", ",", " ", 
