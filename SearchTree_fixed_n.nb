     RowBox[{"(*", 
      RowBox[{"Important", " ", "values", " ", "and", " ", "lists"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vertexCount", "=", 
       RowBox[{"VertexCount", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"edgeCount", " ", "=", " ", 
       RowBox[{"EdgeCount", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vertexList", " ", "=", " ", 
