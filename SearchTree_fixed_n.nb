Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", " ", "=", "6"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GoodChildQ", "[", "G_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], " ", "<=", "n"}], ")"}], " ", 
     "\[And]", 
     RowBox[{"(", 
      RowBox[{"SubsetQ", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Binomial", "[", 
          RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"EdgeWeights", "[", "G", "]"}]}], "]"}], ")"}], "\[And]", 
     RowBox[{"(", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"First", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Tally", "@", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Flatten", "@", 
               RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], ",", "0."}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], ">", "2"}], "&"}]}], "]"}]}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{"NextWeight", "[", "G", "]"}], "<=", "#"}], "&"}]}], "]"}], 
      ")"}], "\[And]", 
     RowBox[{"(", 
      RowBox[{"Not", "[", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"PDGs", ",", 
         RowBox[{
          RowBox[{"IsomorphicSubgraphQ", "[", 
           RowBox[{"#", ",", "G"}], "]"}], "&"}]}], "]"}], "]"}], ")"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PDGs", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stack", " ", "=", 
   RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gstart", " ", "=", " ", 
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", "\[UndirectedEdge]", "2"}], "}"}], ",", 
      RowBox[{"EdgeWeight", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "\[UndirectedEdge]", "2"}], "->", "1"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stack", "[", 
    RowBox[{"\"\<Push\>\"", ",", "Gstart"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TotalTime", " ", "=", " ", 
   RowBox[{
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Depth", " ", "First", " ", "Search"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Until", "[", 
       RowBox[{
        RowBox[{"stack", "[", "\"\<EmptyQ\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"G", " ", "=", " ", 
          RowBox[{"stack", "[", "\"\<Pop\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"VertexCount", "[", "G", "]"}], "==", "n"}], " ", 
             "\[And]", " ", 
             RowBox[{"PerfectDistanceQ", "[", "G", "]"}]}], ")"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"PDGs", ",", "G"}], "]"}], ";"}], "\[IndentingNewLine]", 
           ",", 
           RowBox[{"(*", "Else", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"children", " ", "=", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"Children", "[", "G", "]"}], ",", "GoodChildQ"}], 
                "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"LineGraph", "[", "#1", "]"}], "==", 
                  RowBox[{"LineGraph", "[", "#2", "]"}]}], "&&", 
                 RowBox[{"IsomorphicGraphQ", "[", 
                  RowBox[{"#1", ",", "#2"}], "]"}]}], "&"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"stack", "[", 
               RowBox[{"\"\<Push\>\"", ",", "g"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"g", ",", "children"}], "}"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
      ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "[", 
