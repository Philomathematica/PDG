Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PerfectDistanceQ", "[", "G_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "@*", "Flatten", "@*", "Round"}], "@", 
       RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], " ", "==", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}], ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NewWeight", "[", "G_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"distances", ",", "nextWeight"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"distances", " ", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Union", "@*", "Flatten", "@*", "Round", "@*", 
           "GraphDistanceMatrix", "@*", "Graph"}], "@", "G"}], ",", "0"}], 
        "]"}]}], ";", 
      RowBox[{"nextWeight", " ", "=", " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"AnnotationValue", "[", 
          RowBox[{"G", ",", "EdgeWeight"}], "]"}], "]"}], "+", "1"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nextWeight", "<=", 
           RowBox[{"Length", "[", "distances", "]"}]}], ")"}], "\[And]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"distances", "[", 
            RowBox[{"[", "nextWeight", "]"}], "]"}], "==", "nextWeight"}], 
          ")"}]}], ",", 
        RowBox[{"nextWeight", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "nextWeight"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Computes", " ", "Children", " ", "of", " ", "G", " ", "in", " ", "search",
     " ", "for", " ", "Minimal", " ", 
    RowBox[{"PDGs", ".", " ", "Attempting"}], " ", "to", " ", "avoid", " ", 
    "redundant", " ", "function", " ", "calls", " ", 
    RowBox[{"e", ".", "g", ".", " ", "computations"}], " ", "of", " ", 
    "GraphDistanceMatrix"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Children", "[", 
    RowBox[{"G_", ",", "n_", ",", "PDGs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vertexCount", ",", "edgeCount", ",", "vertexList", ",", " ", 
       "edgeList", ",", " ", "weightList", ",", " ", "graphDistanceMatrix", 
       ",", "distances", ",", "distancesDuplicateFree", ",", "newWeight", ",",
        "validNewEdges", ",", "GoodChildQ", ",", "allChildren", ",", 
       "goodChildren"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Important", " ", "values", " ", "and", " ", "lists"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vertexCount", "=", 
       RowBox[{"VertexCount", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"edgeCount", " ", "=", " ", 
       RowBox[{"EdgeCount", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vertexList", " ", "=", " ", 
       RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"edgeList", " ", "=", " ", 
       RowBox[{"EdgeList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"weightList", " ", "=", " ", 
       RowBox[{"AnnotationValue", "[", 
        RowBox[{"G", ",", "EdgeWeight"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "GraphDistanceMatrix", " ", "and", " ", "associated", " ", "distances", 
        RowBox[{"(", 
         RowBox[{"does", " ", "not", " ", "remove", " ", "duplicates"}], 
         ")"}], " ", "and", " ", 
        RowBox[{"distancesDuplicateFree", "."}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"graphDistanceMatrix", " ", "=", " ", 
       RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"distances", "=", " ", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "@*", "Round"}], "@", "graphDistanceMatrix"}], 
         ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"distancesDuplicateFree", " ", "=", " ", 
       RowBox[{"Union", "@", "distances"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Compute", " ", "newWeight"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"newWeight", " ", "=", " ", 
       RowBox[{
        RowBox[{"Max", "[", "weightList", "]"}], "+", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"newWeight", "<=", 
           RowBox[{"Length", "[", "distancesDuplicateFree", "]"}]}], ")"}], 
         "\[And]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"distancesDuplicateFree", "[", 
            RowBox[{"[", "newWeight", "]"}], "]"}], "==", "newWeight"}], 
          ")"}]}], ",", 
        RowBox[{"newWeight", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Compute", " ", "validNewEdges"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"validNewEdges", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#1", "\[UndirectedEdge]", "#2"}], "&"}], "@@@", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"UpperTriangularize", "[", "graphDistanceMatrix", "]"}], 
            ",", 
            RowBox[{"d_", "/;", 
             RowBox[{"newWeight", "<", "d"}]}]}], "]"}]}], ",", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[UndirectedEdge]", 
            RowBox[{"(", 
             RowBox[{"vertexCount", "+", "1"}], ")"}]}], "&"}], "/@", " ", 
          "vertexList"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"vertexCount", "+", "1"}], ")"}], "\[UndirectedEdge]", 
           RowBox[{"(", 
            RowBox[{"vertexCount", "+", "2"}], ")"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Compute", " ", "allChildren"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"allChildren", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"EdgeAdd", "[", 
            RowBox[{"G", ",", "#"}], "]"}], ",", 
           RowBox[{"EdgeWeight", "->", 
            RowBox[{"Append", "[", 
             RowBox[{"weightList", ",", "newWeight"}], "]"}]}]}], "]"}], 
         "&"}], "/@", "validNewEdges"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Define", " ", "FastGoodChildQ"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GoodChildQ", "[", "Gchild_", "]"}], ":=", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"PlanarGraphQ", "[", "Gchild", "]"}], "\[And]"}], "*)"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VertexCount", "[", "Gchild", "]"}], " ", "<=", "n"}], 
         ")"}], " ", "\[And]", 
        RowBox[{"(", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"AnnotationValue", "[", 
            RowBox[{"Gchild", ",", "EdgeWeight"}], "]"}]}], "]"}], ")"}], 
        "\[And]", 
        RowBox[{"(", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"First", "/@", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Tally", "@", 
               RowBox[{"DeleteCases", "[", 
                RowBox[{
                 RowBox[{"Flatten", "@", 
                  RowBox[{"GraphDistanceMatrix", "[", "Gchild", "]"}]}], ",", 
                 "0."}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], ">", "2"}], "&"}]}], "]"}]}],
            ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NewWeight", "[", "Gchild", "]"}], "<=", "#"}], "&"}]}], 
          "]"}], ")"}], "\[And]", 
        RowBox[{"(", 
         RowBox[{"Not", "[", 
          RowBox[{"AnyTrue", "[", 
           RowBox[{"PDGs", ",", 
            RowBox[{
             RowBox[{"IsomorphicSubgraphQ", "[", 
              RowBox[{"#", ",", "Gchild"}], "]"}], "&"}]}], "]"}], "]"}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Reducing", " ", "allChildren", " ", "to", " ", "goodChildren"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"goodChildren", " ", "=", " ", 
