             RowBox[{"IsomorphicSubgraphQ", "[", 
              RowBox[{"#", ",", "Gchild"}], "]"}], "&"}]}], "]"}], "]"}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
