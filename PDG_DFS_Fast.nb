             RowBox[{"weightList", ",", "newWeight"}], "]"}]}]}], "]"}], 
         "&"}], "/@", "validNewEdges"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Define", " ", "FastGoodChildQ"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GoodChildQ", "[", "Gchild_", "]"}], ":=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VertexCount", "[", "Gchild", "]"}], " ", "<=", "n"}], 
         ")"}], " ", "\[And]", 
        RowBox[{"(", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"AnnotationValue", "[", 
            RowBox[{"Gchild", ",", "EdgeWeight"}], "]"}]}], "]"}], ")"}], 
        "\[And]", 
        RowBox[{"(", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"First", "/@", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Tally", "@", 
               RowBox[{"DeleteCases", "[", 
                RowBox[{
                 RowBox[{"Flatten", "@", 
                  RowBox[{"GraphDistanceMatrix", "[", "Gchild", "]"}]}], ",", 
                 "0."}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
