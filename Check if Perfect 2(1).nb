    "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Not Perfect Distance Graphs: \>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{"NotPerfectDistanceGraphs", ",", 
     RowBox[{"TableDirections", "->", "Row"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
