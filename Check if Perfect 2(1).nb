Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Construct", " ", "Graph", " ", "Sets"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vertex5", "=", 
     RowBox[{"allConnectedUpToIso", "[", "5", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"vertex6", "=", 
      RowBox[{"allConnectedUpToIso", "[", "6", "]"}]}], ";"}], 
    "*)"}]}]}]], "Input",
