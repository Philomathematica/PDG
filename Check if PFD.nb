Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "vertex5", " ", "should", " ", "take", " ", "around", " ", "a", " ", 
    "second", "\[IndentingNewLine]", "vertex6", " ", "took", " ", "around", 
    " ", "8", " ", "minutes", " ", "on", " ", "my", " ", "laptop"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "CHOOSE", " ", "SET", " ", "OF", " ", "GRAPHS", " ", "TO", " ", "TEST"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GraphList", " ", "=", " ", "vertex6"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MinimalPerfectDistanceGraphs", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NotPerfectDistanceGraphs", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "GraphList", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"G", " ", "=", " ", 
         RowBox[{"First", "[", "GraphList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphList", " ", "=", " ", 
         RowBox[{"Delete", "[", 
          RowBox[{"GraphList", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Test", " ", "weights", " ", "until", " ", "a", " ", "PDG", " ", 
          "is", " ", "found", " ", "or", " ", "weights", " ", "exausted"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"PerfectDistanceGraph", " ", "=", " ", 
          RowBox[{
          "Null", " ", "if", " ", "G", " ", "does", " ", "not", " ", 
           "support", " ", "a", " ", "perfect", " ", "distance", " ", 
           "weighting"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"WL", " ", "=", " ", 
         RowBox[{"WeightsList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"PerfectDistanceGraph", " ", "=", " ", 
         RowBox[{"Catch", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"PerfectDistanceQ", "[", 
               RowBox[{"Graph", "[", 
                RowBox[{
                 RowBox[{"EdgeList", "[", "G", "]"}], ",", 
                 RowBox[{"EdgeWeight", "->", 
                  RowBox[{"WL", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}], "]"}], ",", 
              RowBox[{"Throw", "[", "G", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "WL", "]"}]}], "}"}]}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Update", " ", "MPDG", " ", "and", " ", 
          RowBox[{"NPD", ":", " ", 
           RowBox[{
           "Comparisions", " ", "to", " ", "Null", " ", "are", " ", 
            "probelmatic"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "PerfectDistanceGraph", "]"}], "==", 
           "Graph"}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
           "MinimalPerfectDistanceGraphs", ",", "PerfectDistanceGraph"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PerfectDistanceGraph", "==", "Null"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"NotPerfectDistanceGraphs", ",", "G"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Trim", " ", "Graph", " ", "List"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"GraphList", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"GraphList", ",", 
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"IsomorphicSubgraphQ", "[", 
              RowBox[{"PerfectDistanceGraph", ",", "#"}], "]"}], "]"}], 
            "&"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
