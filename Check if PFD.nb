Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Brute", " ", "force", " ", "construction", " ", "of", " ", "all", " ", 
    "Graphs", " ", "on", " ", "n", " ", "vertices", " ", "up", " ", "to", " ",
     "Isomorphism"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"allEdges", "[", "n_", "]"}], ":=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"UndirectedEdge", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allConnected", "[", "n_", "]"}], ":=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"Range", "[", "n", "]"}], ",", "#", ",", 
            RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}], "&"}], ",", 
         RowBox[{"Subsets", "[", 
          RowBox[{"allEdges", "[", "n", "]"}], "]"}]}], "]"}], ",", 
       "ConnectedGraphQ"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allConnectedUpToIso", "[", "n_", "]"}], ":=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{
       RowBox[{"allConnected", "[", "n", "]"}], ",", "IsomorphicGraphQ"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PerfectDistanceQ", "[", "G_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Round", "[", 
        RowBox[{"GraphDistanceMatrix", "[", "G", "]"}], "]"}], "]"}], "]"}], 
     " ", "==", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Binomial", "[", 
        RowBox[{
         RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"WeightsList", "[", "G_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Permutations", "[", "#", "]"}], "&"}], "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"EdgeCount", "[", "G", "]"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", "1"}], "]"}], "&&", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", "2"}], "]"}]}], "&"}]}], "]"}]}], ",", "1"}], 
     "]"}]}], " ", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9140016494832773`*^9, 3.914001684562351*^9}, {
