a1353668a54f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Temp1", " ", "=", " ", 
     RowBox[{"TopologicalSort", "[", 
      RowBox[{
       RowBox[{"ResourceFunction", "[", "\"\<HasseDiagram\>\"", "]"}], "[", 
