Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "CHOOSE", " ", "SET", " ", "OF", " ", "GRAPHS", " ", "TO", " ", "TEST"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GraphList", " ", "=", "vertex5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MinimalPerfectDistanceGraphs", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NotPerfectDistanceGraphs", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "GraphList", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"G", " ", "=", " ", 
         RowBox[{"First", "[", "GraphList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphList", " ", "=", " ", 
         RowBox[{"Delete", "[", 
          RowBox[{"GraphList", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"WL", " ", "=", " ", 
         RowBox[{"WeightsList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"PDGQ", " ", "=", " ", 
         RowBox[{"Catch", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"PerfectDistanceQ", "[", 
               RowBox[{"G", ",", "w"}], "]"}], ",", 
              RowBox[{"Throw", "[", "True", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", "WL"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PDGQ", "===", "True"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"MinimalPerfectDistanceGraphs", ",", "G"}], "]"}], ";", 
           RowBox[{"GraphList", " ", "=", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"GraphList", ",", 
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{"IsomorphicSubgraphQ", "[", 
                 RowBox[{"G", ",", "#"}], "]"}], "]"}], "&"}]}], "]"}]}], 
           ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"NotPerfectDistanceGraphs", ",", "G"}], "]"}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Minimal Perfect Distance Graphs: \>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{"MinimalPerfectDistanceGraphs", ",", 
     RowBox[{"TableDirections", "->", "Row"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Not Perfect Distance Graphs: \>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{"NotPerfectDistanceGraphs", ",", 
     RowBox[{"TableDirections", "->", "Row"}]}], "]"}]}]}]], "Input",
