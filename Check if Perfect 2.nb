Cell[BoxData[{
 RowBox[{
  RowBox[{"GraphList", " ", "=", "vertex5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LStart", " ", "=", " ", 
   RowBox[{"Length", "[", "GraphList", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lenGL", "=", "LStart"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MinimalPerfectDistanceGraphs", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";", " ", 
   RowBox[{"NotPerfectDistanceGraphs", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"P1", "=", 
  RowBox[{"ProgressIndicator", "[", 
   RowBox[{"Dynamic", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"LStart", "-", "lenGL"}], ")"}], "/", "LStart"}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P2", "=", 
   RowBox[{"ProgressIndicator", "[", 
    RowBox[{"Dynamic", "[", 
     RowBox[{"status", "/", "lenW"}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TotalTime", " ", "=", " ", 
    RowBox[{
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "GraphList", "]"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"G", " ", "=", " ", 
           RowBox[{"First", "[", "GraphList", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"GraphList", " ", "=", " ", 
           RowBox[{"Delete", "[", 
            RowBox[{"GraphList", ",", "1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"W", " ", "=", " ", 
           RowBox[{"WeightSets", "[", 
            RowBox[{
             RowBox[{"VertexCount", "[", "G", "]"}], ",", 
             RowBox[{"EdgeCount", "[", "G", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"status", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"lenW", " ", "=", " ", 
           RowBox[{"Length", "[", "W", "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"PDGQ", " ", "=", 
           RowBox[{"Catch", "[", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"WL", " ", "=", " ", 
                RowBox[{"Permutations", "[", "Wi", "]"}]}], ";", 
               RowBox[{"ResWi", " ", "=", 
                RowBox[{"Catch", "[", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"PerfectDistanceQ", "[", 
                    RowBox[{"G", ",", "w"}], "]"}], ",", 
                    RowBox[{"Throw", "[", "True", "]"}]}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"w", ",", "WL"}], "}"}]}], "]"}], "]"}]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"ResWi", "===", "True"}], ",", 
                 RowBox[{"Throw", "[", "ResWi", "]"}]}], "]"}], ";", 
               RowBox[{"status", "++"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"Wi", ",", "W"}], "}"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"PDGQ", "===", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"MinimalPerfectDistanceGraphs", ",", "G"}], "]"}], ";", 
             RowBox[{"GraphList", " ", "=", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"GraphList", ",", 
                RowBox[{
                 RowBox[{"Not", "[", 
                  RowBox[{"IsomorphicSubgraphQ", "[", 
                   RowBox[{"G", ",", "#"}], "]"}], "]"}], "&"}]}], "]"}]}], 
             ";"}], "\[IndentingNewLine]", ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"NotPerfectDistanceGraphs", ",", "G"}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"lenGL", " ", "=", " ", 
           RowBox[{"Length", "[", "GraphList", "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", "]"}], 
     "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\[IndentingNewLine]", 
  RowBox[{"\"\<Time To Compute:\\t\>\"", ",", 
   RowBox[{"TimeObject", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "TotalTime"}], "}"}], "]"}], ",", 
   "\"\< and \>\"", ",", 
   RowBox[{"1000", 
    RowBox[{"FractionalPart", "[", "TotalTime", "]"}]}], ",", "\"\<ms\\n\>\"",
    ",", "\[IndentingNewLine]", "\"\<Minimal Perfect Distance Graphs(\>\"", 
   ",", 
   RowBox[{"Length", "[", "MinimalPerfectDistanceGraphs", "]"}], ",", 
