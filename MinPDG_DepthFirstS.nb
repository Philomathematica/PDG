 RowBox[{
  RowBox[{
   RowBox[{"Children", "[", 
    RowBox[{"G_", ",", "n_", ",", "PDGs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vertexCount", ",", "edgeCount", ",", "vertexList", ",", " ", 
