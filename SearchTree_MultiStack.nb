Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PerfectDistanceQ", "[", "G_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "@*", "Flatten", "@*", "Round"}], "@", 
       RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], " ", "==", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}], ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EdgeWeights", "[", "G_", "]"}], ":=", 
    RowBox[{"AnnotationValue", "[", 
     RowBox[{"G", ",", "EdgeWeight"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NoNewVertex", "[", "G_", "]"}], ":=", 
  RowBox[{"Complement", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "\[UndirectedEdge]", "#2"}], "&"}], "@@@", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "G", "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], ",", 
    RowBox[{"EdgeList", "[", "G", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OneNewVertex", "[", "G_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "\[UndirectedEdge]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], "+", "1"}], ")"}]}], "&"}], "/@",
    " ", 
   RowBox[{"VertexList", "[", "G", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TwoNewVertex", "[", "G_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"VertexCount", "[", "G", "]"}], "+", "1"}], ")"}], 
    "\[UndirectedEdge]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"VertexCount", "[", "G", "]"}], "+", "2"}], ")"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NewEdges", "[", "G_", "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"NoNewVertex", "[", "G", "]"}], ",", 
     RowBox[{"OneNewVertex", "[", "G", "]"}], ",", 
     RowBox[{"TwoNewVertex", "[", "G", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NextWeight", "[", "G_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"distances", ",", "nextWeight"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"distances", " ", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Union", "@*", "Flatten", "@*", "Round", "@*", 
           "GraphDistanceMatrix", "@*", "Graph"}], "@", "G"}], ",", "0"}], 
        "]"}]}], ";", 
      RowBox[{"nextWeight", " ", "=", " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"EdgeWeights", "[", "G", "]"}], "]"}], "+", "1"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nextWeight", "<=", 
           RowBox[{"Length", "[", "distances", "]"}]}], ")"}], "\[And]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"distances", "[", 
            RowBox[{"[", "nextWeight", "]"}], "]"}], "==", "nextWeight"}], 
          ")"}]}], ",", 
        RowBox[{"nextWeight", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "nextWeight"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
