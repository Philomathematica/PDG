 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GoodChildQ", "[", "G_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], " ", "<=", "n"}], ")"}], " ", 
     "\[And]", 
     RowBox[{"(", 
      RowBox[{"SubsetQ", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Binomial", "[", 
          RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"EdgeWeights", "[", "G", "]"}]}], "]"}], ")"}], "\[And]", 
     RowBox[{"(", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"First", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Tally", "@", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Flatten", "@", 
               RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], ",", "0."}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], ">", "2"}], "&"}]}], "]"}]}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{"NextWeight", "[", "G", "]"}], "<=", "#"}], "&"}]}], "]"}], 
      ")"}], "\[And]", 
     RowBox[{"(", 
      RowBox[{"Not", "[", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"PDGs", ",", 
         RowBox[{
          RowBox[{"IsomorphicSubgraphQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{"CanonicalGraph", "[", "G", "]"}]}], "]"}], "&"}]}], 
