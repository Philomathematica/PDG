                    RowBox[{"Throw", "[", "True", "]"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"w", ",", 
                    RowBox[{"Permutations", "[", "#", "]"}]}], "}"}]}], "]"}],
                     "]"}], "===", "True"}], ",", "True", ",", "$Failed"}], 
                 "]"}]}], ")"}], "&"}], ",", "W", ",", 
