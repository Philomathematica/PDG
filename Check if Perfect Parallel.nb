 RowBox[{
  RowBox[{
   RowBox[{"TotalTime", " ", "=", " ", 
    RowBox[{
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "GraphList", "]"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"G", " ", "=", " ", 
           RowBox[{"First", "[", "GraphList", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"GraphList", " ", "=", " ", 
