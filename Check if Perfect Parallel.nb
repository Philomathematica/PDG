Notebook[{

Cell[CellGroupData[{
Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.9163414794538918`*^9, 
  3.91634148014145*^9}},ExpressionUUID->"c5920964-336f-4185-bd35-\
15168cb33b82"],

Cell["\<\
\tMaybe we can test random weights for some number of attempts then skip to \
next if none are found. This random search would reduce memory complexity of \
the algorithm. 
\t\tFirst: Test random weights to reduce Graph List
\t \tSecond: Complete Test of all weights
\t \tThird: ?
\t
\tUnderstanding the relationships between graphs would be nice. We could test \
the graphs in order of inclusion as a subgraph. So Construct a Poset of the \
graphs where the order is by inclusion as isomorphic subgraphs ( Not sure if \
this actually leads to a Poset structure but the idea is still there). Then \
perform tests according to the ordering.\
\>", "Text",
 CellChangeTimes->{{3.91634143419013*^9, 
  3.916341469568084*^9}},ExpressionUUID->"51657fc0-93d4-4649-9560-\
9e4c1c532d3e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Code", "Subsubsection",
 CellChangeTimes->{{3.916341493857782*^9, 
  3.916341494190936*^9}},ExpressionUUID->"177fede9-0c9b-4fb2-a2d9-\
e6706bf20f10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Brute", " ", "force", " ", "construction", " ", "of", " ", "all", " ", 
    "Graphs", " ", "on", " ", "n", " ", "vertices", " ", "up", " ", "to", " ",
     "Isomorphism"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"allEdges", "[", "n_", "]"}], ":=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"UndirectedEdge", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allConnected", "[", "n_", "]"}], ":=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"Range", "[", "n", "]"}], ",", "#", ",", 
            RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}], "&"}], ",", 
         RowBox[{"Subsets", "[", 
          RowBox[{"allEdges", "[", "n", "]"}], "]"}]}], "]"}], ",", 
       "ConnectedGraphQ"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allConnectedUpToIso", "[", "n_", "]"}], ":=", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"allConnected", "[", "n", "]"}], ",", "CanonicalGraph"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PerfectDistanceQ", "[", 
      RowBox[{"G_", ",", "w_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "@*", "Flatten", "@*", "Round"}], "@", 
       RowBox[{"GraphDistanceMatrix", "[", 
        RowBox[{"Graph", "[", 
         RowBox[{"G", ",", 
          RowBox[{"EdgeWeight", "->", "w"}]}], "]"}], "]"}]}], " ", "==", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"WeightsList", "[", "G_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Permutations", "[", "#", "]"}], "&"}], "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"EdgeCount", "[", "G", "]"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", "1"}], "]"}], "&&", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", "2"}], "]"}]}], "&"}]}], "]"}]}], ",", "1"}], 
     "]"}]}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WeightSets", "[", 
      RowBox[{"Vn_", ",", "En_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"WeightSets", "[", 
       RowBox[{"Vn", ",", "En"}], "]"}], "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Binomial", "[", 
            RowBox[{"Vn", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"{", "En", "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"#", ",", "1"}], "]"}], "&&", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"#", ",", "2"}], "]"}]}], "&"}]}], "]"}]}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalWeightings", "[", "G_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"EdgeCount", "[", "G", "]"}], "!"}], 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}], "-", 
         "2"}], ",", 
        RowBox[{
         RowBox[{"EdgeCount", "[", "G", "]"}], "-", "2"}]}], "]"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StatusGraph", "[", 
      RowBox[{"GraphList_", ",", "NPDG_", ",", "MPDG_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "G", "}"}], ",", 
       RowBox[{
        RowBox[{"G", " ", "=", 
         RowBox[{
          RowBox[{"ResourceFunction", "[", "\"\<HasseDiagram\>\"", "]"}], "[", 
          RowBox[{"IsomorphicSubgraphQ", ",", "GraphList"}], "]"}]}], ";", 
        " ", 
        RowBox[{"HighlightGraph", "[", 
         RowBox[{"G", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"NPDG", ",", "Red"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"VertexOutComponent", "[", 
               RowBox[{"G", ",", "MPDG"}], "]"}], ",", "Green"}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"GraphLayout", "->", "\"\<LayeredDigraphEmbedding\>\""}], 
          ",", 
          RowBox[{"VertexLabels", "->", 
           RowBox[{"MapIndexed", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "->", 
               RowBox[{"Placed", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"VertexList", "[", "G", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "}"}], ",", 
                 RowBox[{"{", "Tooltip", "}"}]}], "]"}]}], "&"}], ",", 
             RowBox[{"VertexList", "[", "G", "]"}]}], "]"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TimeToCheckPerWeight", " ", "=", "0.000021175520621353957`"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", "PerfectDistanceQ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"statusP", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"SetSharedVariable", "[", "statusP", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
