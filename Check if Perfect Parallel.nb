          "\[IndentingNewLine]", 
          RowBox[{"DistributeDefinitions", "[", "G", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"PDGQ", "=", 
           RowBox[{"ParallelTry", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"statusP", "++"}], ";", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Catch", "[", 
