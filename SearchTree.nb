Cell[BoxData[{
 RowBox[{
  RowBox[{"GraphOfGraphs", "[", "G_", "]"}], ":=", 
  RowBox[{"Graph", "[", 
   RowBox[{"G", ",", 
    RowBox[{"VertexLabels", "->", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexList", "[", "G", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"#2", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "}"}], ",", 
           RowBox[{"{", "Tooltip", "}"}]}], "]"}]}], "&"}], ",", 
       RowBox[{"VertexList", "[", "G", "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PerfectDistanceQ", "[", "G_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "@*", "Flatten", "@*", "Round"}], "@", 
       RowBox[{"GraphDistanceMatrix", "[", "G", "]"}]}], " ", "==", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}], ")"}], "\[And]", 
    RowBox[{"(", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "G", "]"}], ",", "2"}], "]"}], "]"}], 
       ",", 
       RowBox[{"AnnotationValue", "[", 
        RowBox[{"G", ",", "EdgeWeight"}], "]"}]}], "]"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NoNewVertex", "[", "G_", "]"}], ":=", 
  RowBox[{"Complement", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "\[UndirectedEdge]", "#2"}], "&"}], "@@@", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "G", "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], ",", 
    RowBox[{"EdgeList", "[", "G", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OneNewVertex", "[", "G_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "\[UndirectedEdge]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], "+", "1"}], ")"}]}], "&"}], "/@",
    " ", 
   RowBox[{"VertexList", "[", "G", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TwoNewVertex", "[", "G_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], "+", "1"}], ")"}], 
     "\[UndirectedEdge]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"VertexCount", "[", "G", "]"}], "+", "2"}], ")"}]}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NewEdges", "[", "G_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"NoNewVertex", "[", "G", "]"}], "\[Union]", 
    RowBox[{"OneNewVertex", "[", "G", "]"}], "\[Union]", 
    RowBox[{"TwoNewVertex", "[", "G", "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NextWeight", "[", "G_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"distances", ",", "nextWeight"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"distances", " ", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Union", "@*", "Flatten", "@*", "Round", "@*", 
           "GraphDistanceMatrix", "@*", "Graph"}], "@", "G"}], ",", "0"}], 
        "]"}]}], ";", 
      RowBox[{"nextWeight", " ", "=", " ", "1"}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nextWeight", "<=", 
           RowBox[{"Length", "[", "distances", "]"}]}], ")"}], "\[And]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"distances", "[", 
            RowBox[{"[", "nextWeight", "]"}], "]"}], "==", "nextWeight"}], 
          ")"}]}], ",", 
        RowBox[{"nextWeight", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "nextWeight"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AddWeightedEdge", "[", 
    RowBox[{"G_", ",", "e_", ",", "w_"}], "]"}], ":=", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"EdgeAdd", "[", 
      RowBox[{"G", ",", "e"}], "]"}], ",", 
     RowBox[{"EdgeWeight", "->", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"AnnotationValue", "[", 
         RowBox[{"G", ",", "EdgeWeight"}], "]"}], ",", "w"}], "]"}]}]}], 
    "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "add", " ", "edge", " ", "e", " ", "to", " ", "G", " ", "with", " ", 
    "weight", " ", "w"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"IsomorphicWeightingQ", "[", 
     RowBox[{"G1_", ",", "G2_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"LineGraph", "[", "G1", "]"}], "==", 
       RowBox[{"LineGraph", "[", "G2", "]"}]}], ",", "True", ",", "False"}], 
     "]"}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ChildrenNoReduce", "[", "G_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"AddWeightedEdge", "[", 
      RowBox[{"G", ",", "#", ",", 
       RowBox[{"NextWeight", "[", "G", "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"NewEdges", "[", "G", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Children", "[", "G_", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"ChildrenNoReduce", "[", "G", "]"}], ",", 
     RowBox[{
      RowBox[{"DuplicateFreeQ", "[", 
       RowBox[{"AnnotationValue", "[", 
        RowBox[{"#", ",", "EdgeWeight"}], "]"}], "]"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ChildrenEdges", "[", "G_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "\[UndirectedEdge]", "#"}], "&"}], "/@", 
     RowBox[{"Children", "[", "G", "]"}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Used", " ", "to", " ", "add", " ", "new", " ", "graphs", " ", "to", " ", 
    "search", " ", "Tree"}], "*)"}]}]}], "Input",
